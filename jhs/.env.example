# ── 데이터베이스 ────────────────────────────────────────────
# 정본 스키마는 Postgres(prisma/schema.prisma, provider="postgresql").
#
# 로컬 개발(SQLite): `npm run dev:sqlite` 사용 — 파생 스키마가 file:./dev.db 를
#   직접 가리키므로 아래 DB url 들은 비워둬도 됨.
# 프로덕션(Neon): Vercel 이 아래 두 값을 주입. 로컬에서 Neon 에 직접 쓰려면
#   (예: catalog:restore) 두 값을 채운다.
DATABASE_URL=
# POSTGRES_PRISMA_URL=        # pooled (pgbouncer) — 런타임 쿼리
# POSTGRES_URL_NON_POOLING=   # direct — migrations / db push

# ── Google OAuth (로그인 식별용 — YouTube 권한 요청 안 함) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ────────────────────────────────────────────────
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# 로컬: http://localhost:3000 / 배포: https://<your-app>.vercel.app
NEXTAUTH_URL=

# ── (선택) Upstash Redis 캐시 — 미설정 시 in-memory fallback ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
