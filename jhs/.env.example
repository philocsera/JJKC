# ── 데이터베이스 ────────────────────────────────────────────
# 로컬 개발: SQLite  →  DATABASE_URL="file:./dev.db"  (+ schema.prisma provider="sqlite")
# Vercel 배포: Vercel Postgres / Neon connection string (provider="postgresql")
DATABASE_URL=

# ── Google OAuth (로그인 식별용 — YouTube 권한 요청 안 함) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ────────────────────────────────────────────────
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# 로컬: http://localhost:3000 / 배포: https://<your-app>.vercel.app
NEXTAUTH_URL=

# ── (선택) Upstash Redis 캐시 — 미설정 시 in-memory fallback ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
