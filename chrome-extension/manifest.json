{
  "manifest_version": 3,
  "name": "JJKC Algorithm Viewer",
  "version": "1.0.0",
  "description": "JJKC 사이트 로그인 정보를 받아와 내 알고리즘 기반 지금 보는 유튜브 영상이 얼마나 내 알고리즘과 유사한지 보여주는 확장 프로그램입니다. 유저 피드백을 받아 사이트 DB에 익명으로 저장하는 기능도 포함되어 있습니다.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://ytalgoshare.vercel.app/*",
    "https://jjkc-algo-blush.vercel.app/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jjkc-algo-blush.vercel.app/*",
        "https://ytalgoshare.vercel.app/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JJKC Algorithm Viewer",
    "default_popup": "popup.html"
  }
}